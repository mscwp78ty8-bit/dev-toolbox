{
  "name": "editor-title-actions",
  "displayName": "Editor Title Actions",
  "description": "Adds a Toggle Panel button to the editor title bar.",
  "version": "0.1.0",
  "publisher": "local",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onCommand:editorTitleActions.togglePanel"
  ],
  "contributes": {
    "commands": [
      {
        "command": "editorTitleActions.togglePanel",
        "title": "Toggle Panel",
        "icon": "$(layout-panel)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "editorTitleActions.togglePanel",
          "group": "navigation@100001"
        }
      ]
    }
  },
  "license": "MIT",
  "scripts": {
    "package": "npx --yes @vscode/vsce@latest package --allow-missing-repository --skip-license",
    "reinstall": "npm run package && code --install-extension editor-title-actions-0.1.0.vsix --force"
  }
}